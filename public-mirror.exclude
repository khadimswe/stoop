# What the public mirror of this repository leaves out, in every commit of its history.
#
# Qloo's hackathon developer guide: "Do not store Qloo response data in a public repository."
# Recorded Qloo responses, and every file built from them (entity ids, names Qloo returned,
# affinity or popularity scores, ranks, tags, demographics, heatmap values), stay in the
# working repository only. README.md ("Data and the Qloo API") explains how to record your own.
#
# One source of truth, read by two tools:
#   - .github/workflows/public-mirror.yml filters history with `git filter-repo --invert-paths`
#     (path lines, through `node scripts/public-mirror.mjs filter-args`) and
#     `--strip-blobs-with-ids` (the blob: lines).
#   - `npm run check:public` fails when any of these paths exists in the filtered tree or history.
#
# Path lines use git filter-repo's syntax: a literal path matches that file or everything under
# that directory; `glob:` matches the whole path (`*` crosses slashes); `regex:` is searched in
# the path (write only syntax Python and JavaScript read the same way).
# A change here rewrites the mirror's history from the first commit it touches: when a line removes
# a path that already reached the mirror, the next push is no longer a fast-forward and stops
# (MIRROR.md says what to do then).

# Recorded Qloo responses: every fixture at the top of fixtures/, plain or gzipped.
regex:^fixtures/[^/]+\.json(\.gz)?$
# Full raw Qloo bodies (gitignored; listed in case one is ever added).
fixtures/raw/
# Recorded Claude answers for the example runs: they cite Qloo entity ids and names.
fixtures/llm/
# Recipes that hold ids or names Qloo returned (resolved seeds, top picks, panel ids, top metros).
# The four kept hold only queries Stoop wrote: smoke, probe-search, pool-resolve, pool-refresh-2.
regex:^fixtures/recipes/(?!(smoke|probe-search|pool-resolve|pool-refresh-2)\.json$)
# The stored example runs: reports and event traces built from Qloo answers.
data/runs/
# The stored example store plans: the same, for store events.
data/plans/
# The proof lab: plans for real store locations, the Qloo and Claude answers behind them, and the
# store points (real locations, never published; write-ups name areas only).
data/proof/
# The frozen reference panels: Qloo entity and tag ids, names and popularity.
data/culture/
# Reference audiences for city ranking: per-cell sums of Qloo heatmap percentiles.
data/geo/reference-heatmap.json
# The Gate 2 analysis: per-candidate skews, cities, segments, top picks and panel positions.
data/data-check/
# The /mcp page's example session: score_brief's answer (Qloo tags and panel positions).
data/marketing/
# The data check's per-product and per-entity results.
docs/data-check-details.md
# Founder notes for running the mirror.
MIRROR.md
# Dependency update config: updates land here and reach the mirror with main. In the mirror, the
# same file would open pull requests there, and merging one would stop every later mirror push.
.github/dependabot.yml
# macOS folder metadata committed by accident once (it names local files).
regex:(^|/)\.DS_Store$

# Names the Qloo name check (`--names-from`) would flag that are ordinary words or public place
# names in Stoop's own code: a site name, phrases in comments, US states and the counties and
# towns that locality tests and comments use to show how a city name is matched.
allow-name: GitHub
allow-name: The Report
allow-name: Echo Park
allow-name: Puerto Rico
allow-name: West Virginia
allow-name: Hong Kong
allow-name: Washoe County
allow-name: East Baton Rouge Parish
# Store events: a holiday and the example store's area, both common words.
allow-name: Mother's Day
allow-name: West End
allow-name: Flint Charter Township
allow-name: Genesee County

# Old versions of kept files that held Qloo data before it moved to the paths above (an earlier
# panels module, tests with recorded ids or names inline, the first data check write-ups, comments
# quoting Qloo answers). Each line is a blob id, then the path it had; the filter drops that version
# from history (the file keeps its previous clean version, or is absent until a clean one lands).
