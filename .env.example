# Storage for storyboard frames (lib/storage.ts): blob (default, Vercel Blob) or r2 (Cloudflare R2)
STORAGE_DRIVER=
# Cloudflare R2, only when STORAGE_DRIVER=r2; R2_PUBLIC_URL is the bucket's public https URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Waitlist confirmation emails through Resend; skipped while either is empty. EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
# The founder's waitlist CSV: GET /api/waitlist/export with "Authorization: Bearer <token>". 404 while empty or shorter than 32 characters.
WAITLIST_EXPORT_TOKEN=

# Facebook and Instagram posting (lib/social): off unless ENABLE_META_POSTING=true and both app keys are set
ENABLE_META_POSTING=
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
